# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=job_agent

# --- AI Provider ---
# This is the ONLY place the AI provider is configured (no UI toggle).
# Set to "ollama" for local models, or "gemini" for the Gemini API,
# then restart the server to apply.
AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Gemini (cloud) - only needed if you plan to use Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- App ---
APP_ENV=development
UPLOAD_DIR=uploads

# --- Email Notifications ---
# EMAIL_PROVIDER options:
#   mailjet  - RECOMMENDED. Permanent free plan (200/day, 6000/month),
#              no credit card. Works immediately after a normal
#              sender-email confirmation click - no manual review wait.
#              Sign up: https://www.mailjet.com
#   brevo    - Also permanent free plan (300/day) but gates transactional
#              sending behind a manual support-ticket approval for every
#              new account (typically 1-2 business days).
#   sendgrid - Free tier is now a 60-day TRIAL only (SendGrid removed
#              their permanent free plan in 2025) - only useful short-term.
#   smtp     - Local dev or a PAID Render plan only. Render's FREE plan
#              blocks outbound SMTP ports (25/465/587) entirely as a
#              platform policy - this will never work there regardless
#              of settings.
EMAIL_PROVIDER=mailjet

# Mailjet (recommended)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# Brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: overrides the "email" field in your Job Search Config as the notification recipient
NOTIFY_EMAIL_TO=

# SendGrid (60-day trial only as of 2025 - see note above)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# --- Scheduler (daily job search + follow-up reminders) ---
ENABLE_SCHEDULER=true
DAILY_SEARCH_HOUR_UTC=3
DAILY_REMINDER_HOUR_UTC=4

# --- Adzuna (free job-search API - actually indexes India, unlike Remotive/Arbeitnow) ---
# Sign up free at https://developer.adzuna.com/ to get these
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
